{
	"name": "upda-ui",
	"version": "8.3.1",
	"private": true,
	"author": "varakh@varakh.de",
	"type": "module",
	"engines": {
		"node": ">=22",
		"npm": ">=10",
		"pnpm": ">=10"
	},
	"scripts": {
		"start": "vite",
		"build": "tsc && vite build",
		"serve": "vite preview",
		"test": "vitest watch",
		"test:no-watch": "vitest run",
		"test:coverage": "vitest run --coverage --passWithNoTests",
		"format": "prettier --write ./src/**/*.{ts,tsx,less}",
		"format:check": "prettier --check ./src/**/*.{ts,tsx,less}",
		"lint": "eslint \"./src/**/*.{tsx,ts}\"",
		"lint:errors": "eslint --quiet \"./src/**/*.{tsx,ts}\"",
		"lint:fix": "eslint --fix \"./src/**/*.{tsx,ts}\"",
		"lint:style": "stylelint \"./src/**/*.less\"",
		"lint:style:fix": "stylelint \"./src/**/*.less\" --fix",
		"checkstyle": "pnpm run checkstyle:ts && pnpm run checkstyle:style && pnpm run checkstyle:format && pnpm run checkstyle:i18n",
		"checkstyle:format": "pnpm run format:check",
		"checkstyle:ts": "eslint \"./src/**/*.{ts,tsx}\" -f checkstyle > ci/eslint.xml",
		"checkstyle:style": "stylelint \"./src/**/*.less\" --custom-formatter stylelint-checkstyle-formatter -o ci/stylelint.xml",
		"checkstyle:i18n": "sync-i18n --check --files '**/translations/*.json' --primary en --languages en --space 2 --lineendings LF",
		"i18n-sync": "sync-i18n --files '**/translations/*.json' --primary en --languages en --space 2 --lineendings LF",
		"clean": "npx --quiet rimraf build && npx --quiet rimraf ci/*.xml && npx --quiet rimraf coverage && npx --quiet rimraf node_modules"
	},
	"dependencies": {
		"@ant-design/icons": "6.3.2",
		"@ant-design/pro-layout": "7.22.7",
		"@dnd-kit/core": "6.3.1",
		"@dnd-kit/modifiers": "9.0.0",
		"@dnd-kit/sortable": "10.0.0",
		"@dnd-kit/utilities": "3.2.2",
		"@reduxjs/toolkit": "2.12.0",
		"@uiw/react-md-editor": "4.1.2",
		"antd": "6.6.1",
		"html-react-parser": "6.1.7",
		"i18next": "26.4.0",
		"i18next-browser-languagedetector": "8.2.1",
		"linkify-html": "4.3.3",
		"linkifyjs": "4.3.3",
		"lodash": "4.18.1",
		"moment-timezone": "0.6.3",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-i18next": "17.0.12",
		"react-markdown": "10.1.0",
		"react-redux": "9.3.0",
		"react-router": "8.3.0",
		"rehype-sanitize": "6.0.0",
		"remark-gfm": "4.0.1",
		"typescript": "6.0.3"
	},
	"devDependencies": {
		"@eslint/compat": "2.1.0",
		"@eslint/js": "10.0.1",
		"@types/lodash": "4.17.25",
		"@types/node": "24.1.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"@typescript-eslint/eslint-plugin": "8.68.0",
		"@typescript-eslint/parser": "8.68.0",
		"@vitejs/plugin-react": "6.1.0",
		"@vitest/coverage-v8": "4.1.11",
		"eslint": "10.9.1",
		"eslint-config-prettier": "10.1.8",
		"eslint-formatter-checkstyle": "9.0.1",
		"eslint-import-resolver-typescript": "4.4.5",
		"eslint-plugin-import": "2.32.0",
		"eslint-plugin-jsx-a11y": "6.10.2",
		"eslint-plugin-prettier": "5.5.6",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-react-hooks": "7.1.1",
		"eslint-plugin-sonarjs": "4.2.0",
		"eslint-plugin-testing-library": "7.16.2",
		"i18next-json-sync": "3.1.2",
		"jsdom": "30.0.1",
		"less": "4.9.0",
		"postcss-less": "6.0.0",
		"prettier": "3.9.6",
		"rimraf": "6.1.3",
		"stylelint": "17.14.1",
		"stylelint-checkstyle-formatter": "0.1.2",
		"stylelint-config-standard": "40.0.0",
		"stylelint-declaration-block-no-ignored-properties": "3.0.0",
		"stylelint-order": "8.1.1",
		"stylelint-prettier": "5.0.3",
		"vite": "8.2.2",
		"vite-plugin-eslint2": "5.3.0",
		"vite-plugin-stylelint": "6.3.0",
		"vite-plugin-svgr": "5.2.0",
		"vitest": "4.1.11"
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	}
}
