{
	"name": "upda-ui",
	"version": "rolling",
	"private": true,
	"author": "varakh@varakh.de",
	"type": "module",
	"engines": {
		"node": ">=22",
		"npm": ">=10",
		"pnpm": ">=10"
	},
	"scripts": {
		"start": "vite",
		"build": "tsc && vite build",
		"serve": "vite preview",
		"test": "vitest watch",
		"test:no-watch": "vitest run",
		"test:coverage": "vitest run --coverage --passWithNoTests",
		"format": "prettier --write ./src/**/*.{ts,tsx,less}",
		"format:check": "prettier --check ./src/**/*.{ts,tsx,less}",
		"lint": "eslint \"./src/**/*.{tsx,ts}\"",
		"lint:fix": "eslint --fix \"./src/**/*.{tsx,ts}\"",
		"lint:style": "stylelint \"./src/**/*.less\"",
		"lint:style:fix": "stylelint \"./src/**/*.less\" --fix",
		"checkstyle": "pnpm run checkstyle:ts && pnpm run checkstyle:style && pnpm run checkstyle:format && pnpm run checkstyle:i18n",
		"checkstyle:format": "pnpm run format:check",
		"checkstyle:ts": "eslint \"./src/**/*.{ts,tsx}\" -f checkstyle > ci/eslint.xml",
		"checkstyle:style": "stylelint \"./src/**/*.less\" --custom-formatter stylelint-checkstyle-formatter -o ci/stylelint.xml",
		"checkstyle:i18n": "sync-i18n --check --files '**/translations/*.json' --primary en --languages en --space 2 --lineendings LF",
		"i18n-sync": "sync-i18n --files '**/translations/*.json' --primary en --languages en --space 2 --lineendings LF",
		"clean": "npx --quiet rimraf build && npx --quiet rimraf ci/*.xml && npx --quiet rimraf coverage && npx --quiet rimraf node_modules"
	},
	"dependencies": {
		"@ant-design/icons": "6.1.0",
		"@ant-design/pro-layout": "7.22.7",
		"@reduxjs/toolkit": "2.11.2",
		"@uiw/react-md-editor": "4.0.11",
		"antd": "6.1.2",
		"html-react-parser": "5.2.11",
		"i18next": "25.7.3",
		"i18next-browser-languagedetector": "8.2.0",
		"linkify-html": "4.3.2",
		"linkifyjs": "4.3.2",
		"lodash": "4.17.21",
		"moment-timezone": "0.6.0",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-i18next": "16.5.0",
		"react-markdown": "10.1.0",
		"react-redux": "9.2.0",
		"react-router": "7.11.0",
		"rehype-sanitize": "6.0.0",
		"remark-gfm": "4.0.1",
		"typescript": "5.9.3"
	},
	"devDependencies": {
		"@eslint/compat": "2.0.0",
		"@eslint/js": "9.39.2",
		"@types/lodash": "4.17.21",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@typescript-eslint/eslint-plugin": "8.50.1",
		"@typescript-eslint/parser": "8.50.1",
		"@vitejs/plugin-react": "5.1.2",
		"@vitest/coverage-v8": "4.0.16",
		"eslint": "9.39.2",
		"eslint-config-prettier": "10.1.8",
		"eslint-formatter-checkstyle": "9.0.1",
		"eslint-import-resolver-typescript": "4.4.4",
		"eslint-plugin-import": "2.32.0",
		"eslint-plugin-jsx-a11y": "6.10.2",
		"eslint-plugin-prettier": "5.5.4",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-react-hooks": "7.0.1",
		"eslint-plugin-sonarjs": "3.0.5",
		"eslint-plugin-testing-library": "7.15.3",
		"i18next-json-sync": "3.1.2",
		"jsdom": "27.3.0",
		"less": "4.5.1",
		"postcss-less": "6.0.0",
		"prettier": "3.7.4",
		"rimraf": "6.1.2",
		"stylelint": "16.26.1",
		"stylelint-checkstyle-formatter": "0.1.2",
		"stylelint-config-standard": "39.0.1",
		"stylelint-declaration-block-no-ignored-properties": "2.8.0",
		"stylelint-order": "7.0.0",
		"stylelint-prettier": "5.0.3",
		"vite": "7.3.0",
		"vite-plugin-eslint2": "5.0.4",
		"vite-plugin-stylelint": "6.0.2",
		"vite-plugin-svgr": "4.5.0",
		"vite-tsconfig-paths": "6.0.3",
		"vitest": "4.0.16"
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	}
}
