server {
    listen ${NGINX_PORT};

    root /usr/share/nginx/html;

    gzip on;
    gzip_disable "msie6";

    client_max_body_size 0;

    location ${NGINX_BASE_PATH}assets/ {
        alias /usr/share/nginx/html/assets/;
    }
    location ${NGINX_BASE_PATH}conf/ {
        alias /usr/share/nginx/html/conf/;
    }
    location ${NGINX_BASE_PATH} {
        index index.html;
        try_files $uri $uri/ /index.html;
    }
}